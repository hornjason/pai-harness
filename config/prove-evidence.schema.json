{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prove Evidence",
  "description": "Output artifact from /prove skill",
  "type": "object",
  "required": ["contractVersion", "issueNumber", "verdict", "commitSHA", "capturedAt", "criteriaResults"],
  "properties": {
    "contractVersion": { "type": "string" },
    "issueNumber": { "type": "integer" },
    "verdict": { "type": "string", "enum": ["PROVEN", "UNPROVEN", "INCONCLUSIVE"] },
    "commitSHA": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "beforeEvidence": {
      "$comment": "#1540: UNMEASURED declares no type. The old shape filled an absent before-state with type \"none\", which is a value /goal legitimately writes for a run it did measure, so the two were indistinguishable. Artefacts written before #1540 carry no status and remain valid.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["CAPTURED", "DECLARED_NONE", "UNMEASURED"] },
        "type": { "type": "string", "enum": ["text", "screenshot", "api", "data", "none"] },
        "path": { "type": ["string", "null"] },
        "capturedAt": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "An unmeasured reading says why, and never claims a type.",
          "if": { "properties": { "status": { "const": "UNMEASURED" } }, "required": ["status"] },
          "then": { "required": ["reason"], "not": { "required": ["type"] } }
        },
        {
          "$comment": "Any reading that is not UNMEASURED was taken, so it carries when.",
          "if": {
            "properties": { "status": { "enum": ["CAPTURED", "DECLARED_NONE"] } },
            "required": ["status"]
          },
          "then": { "required": ["type", "capturedAt"] }
        }
      ]
    },
    "afterEvidence": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["text", "screenshot", "api"] },
        "path": { "type": "string" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "environment": { "type": "string", "enum": ["local", "prod"] },
        "description": { "type": "string" }
      }
    },
    "comparisonSummary": { "type": "string" },
    "quinnVerdict": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
    "reproduced": { "type": "boolean" },
    "criteriaResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scId", "verdict", "evidence"],
        "properties": {
          "scId": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
          "evidence": { "type": "string" },
          "evidencePath": { "type": ["string", "null"] },
          "exitCode": { "type": ["integer", "null"] }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac", "status"],
        "properties": {
          "ac": { "type": "string" },
          "status": { "type": "string" },
          "detail": { "type": "string" },
          "priority": { "type": ["string", "null"] },
          "followUpIssue": { "type": ["string", "null"] }
        }
      }
    }
  }
}
