{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/Users/jhorn/Projects/rungate/.claude/**)",
      "Bash(bun *)",
      "Bash(bun test *)",
      "Bash(bunx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Bash(cat *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/AgentBriefGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/WorkflowStateGuard.hook.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/TopLevelCdGuard.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/FindingArbiterGate.hook.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/HookCurrency.hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/hooks/SpecSCGuard.hook.ts"
          }
        ]
      }
    ]
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h"
}
