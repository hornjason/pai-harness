{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/Users/jhorn/Projects/rungate/.claude/**)",
      "Bash(bun *)",
      "Bash(bun test *)",
      "Bash(bunx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(make *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(curl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/jhorn/Projects/rungate/hooks/BashToolGuard.hook.ts"
          },
          {
            "type": "command",
            "command": "bun /Users/jhorn/Projects/rungate/hooks/TestSuiteGuard.hook.ts"
          }
        ]
      }
    ]
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h"
}
